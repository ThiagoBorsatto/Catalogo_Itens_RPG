{
    "compilerOptions": {
        "rootDir": "./",
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "target": "esnext",
        "strict": true,
        "skipLibCheck": true,
        "verbatimModuleSyntax": true,
        "isolatedModules": true,
        "moduleDetection": "force",
        "types": [
            "node"
        ]
    },
    "include": [
        "database.ts",
        "server.ts"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}
